# ---------------------------------------------------------------------------
# Simple Surgery practice website
#
# Copy this to .env.local and fill it in. For a single practice, only
# ADMIN_PASSWORD is required to get going.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# One practice, or many?
#
# SET  -> single tenant. This deployment is one practice, served at the root of
#         the domain with clean URLs. This is how the demo runs, and how you
#         should run it if you cloned the repo for your own surgery.
#
# UNSET-> multi tenant. One deployment serves many practices, each at
#         /their-ods-code, or at their own domain once it is connected. This is
#         how the hosted platform runs. Practices are created by the
#         provisioning flow, not by hand.
# ---------------------------------------------------------------------------
SITE_KEY=my-practice

# Your own domain, if you have one. Only used in multi tenant mode, to tell the
# platform's own hostname apart from a practice's.
# PLATFORM_HOST=sites.simplesurgery.co

# ---------------------------------------------------------------------------
# Admin password
#
# Single tenant only. In multi tenant mode each practice's password lives in
# its own record, set when the site was provisioned, and these are ignored.
# ---------------------------------------------------------------------------

# Use at least 12 characters. This is the only thing protecting your website.
ADMIN_PASSWORD=change-this-to-something-long

# Better for a shared hosting dashboard. Generate one with:
#   npm run hash-password "your password here"
# If set, ADMIN_PASSWORD is ignored.
# ADMIN_PASSWORD_HASH=

# Signs the admin session cookie. Any long random string. If blank it is
# derived from the password, so changing the password signs everyone out.
# SESSION_SECRET=

# ---------------------------------------------------------------------------
# Where your content is stored
#
# Leave STORAGE_DRIVER unset and the right one is detected: Upstash if its
# credentials are present, Firebase if those are, otherwise local files.
#
# IMPORTANT: the local file driver does NOT work on Vercel, Netlify or any
# other serverless host. Their filesystems are read-only and reset on every
# deploy. Add Upstash before you deploy, or your edits will vanish.
# ---------------------------------------------------------------------------
# STORAGE_DRIVER=upstash

# Vercel's Upstash integration injects the KV_ names automatically. Both
# spellings are accepted.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Firebase Firestore, as an alternative to Upstash.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_COLLECTION=simplesurgery

# ---------------------------------------------------------------------------
# Image uploads
#
# All optional. Without any of these, logos and photos are resized in the
# browser and stored inline with your settings, which is fine for a logo and a
# few headshots.
#
# RECOMMENDED. Copy this from the Cloudinary dashboard: Settings, API Keys,
# then the "API environment variable" row. Paste the whole thing, with or
# without the "CLOUDINARY_URL=" prefix. Uploads are signed on the server, so
# the secret never reaches the browser.
# ---------------------------------------------------------------------------
# CLOUDINARY_URL=cloudinary://<api-key>:<api-secret>@<cloud-name>
# CLOUDINARY_FOLDER=simple-surgery

# Alternative to CLOUDINARY_URL if you prefer separate values.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Older, less secure option: an UNSIGNED upload preset, used only if none of
# the above are set. The preset ends up in the browser bundle, so anyone who
# finds it can upload to your account. Prefer CLOUDINARY_URL.
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

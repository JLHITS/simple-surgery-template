# ---------------------------------------------------------------------------
# Simple Surgery practice website
#
# Copy this file to .env.local and fill it in. Only ADMIN_PASSWORD is required
# to get going; everything else has a working default.
# ---------------------------------------------------------------------------

# REQUIRED. The password your staff use to sign in at /admin.
# Use at least 12 characters. This is the only thing protecting your website.
ADMIN_PASSWORD=change-this-to-something-long

# Optional, and better for a shared hosting dashboard. Generate one with:
#   node scripts/hash-password.mjs "your password here"
# If this is set, ADMIN_PASSWORD is ignored.
# ADMIN_PASSWORD_HASH=

# Optional. Signs the admin session cookie. Any long random string.
# If you leave it blank, it is derived from your password, which means changing
# the password signs everyone out. That is usually what you want.
# SESSION_SECRET=

# ---------------------------------------------------------------------------
# Where your content is stored
# ---------------------------------------------------------------------------
# Leave STORAGE_DRIVER unset and the right one is picked automatically:
#   - Upstash if UPSTASH_REDIS_REST_URL is present
#   - Firebase if FIREBASE_PROJECT_ID is present
#   - otherwise a local file at data/site.json
#
# IMPORTANT: the local file driver does NOT work on Vercel, Netlify or any other
# serverless host. Their filesystems are read-only and reset on every deploy.
# Add Upstash before you deploy, or your edits will vanish.
# STORAGE_DRIVER=upstash

# Upstash Redis. Free tier is far more than a practice site needs.
# On Vercel: Storage tab, add Upstash Redis, and these are injected for you.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Only needed if you run several practice sites against ONE database.
# Each deployment gets its own SITE_KEY and therefore its own content.
# Leave unset for a single practice.
# SITE_KEY=fairfield-medical

# Firebase Firestore, as an alternative to Upstash.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_COLLECTION=simplesurgery

# Local file driver only. Filename inside the data folder.
# SITE_DATA_FILE=site.json

# ---------------------------------------------------------------------------
# Image uploads
# ---------------------------------------------------------------------------
# Optional. Without these, logos and photos are resized in the browser and
# stored inline with your settings, which works fine for a logo and a few
# headshots. Add Cloudinary if you want a CDN and automatic WebP.
#
# In Cloudinary: Settings, Upload, add an UNSIGNED upload preset.
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
